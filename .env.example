# ==============================================================================
# Swarm Standalone Gateway Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure your LLM provider keys:
#   cp .env.example .env
# ==============================================================================

# Primary LLM API Key (Groq)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Optional Multi-Provider Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (e.g., gemini-2.0-flash, gemini-1.5-pro)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (e.g., gpt-4o, gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Local Ollama / vLLM / Custom OpenAI-Compatible Endpoints (Optional)
# ------------------------------------------------------------------------------
# SWARM_LLM_URL=http://localhost:11434/v1/chat/completions

# ------------------------------------------------------------------------------
# Gateway Server Configuration (Optional)
# ------------------------------------------------------------------------------
# PORT=8088
# BIND_ADDRESS=127.0.0.1:8088
# LOG_LEVEL=info
